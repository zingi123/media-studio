# Copy to .env or set as real environment variables. Environment variables win over the saved credentials.
# NEVER commit real keys. Normally you do not need this file: keys saved in the app go to the OS credential store.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
# Optional: where MediaStudio keeps settings, work files and projects (default: ~/MediaStudio)
# MEDIASTUDIO_HOME=D:\MediaStudio
